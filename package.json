{
  "name": "pagefolio",
  "version": "1.1.0",
  "description": "Browse, turn pages, and save visible screens as a PDF.",
  "main": "src/main.cjs",
  "author": "Pagefolio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/core.test.cjs",
    "test:desktop": "electron test/desktop.cjs",
    "dist:win": "electron-builder --win zip --x64",
    "package:download": "node scripts/prepare-download.cjs"
  },
  "dependencies": {
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "pdf-lib": "1.17.1"
  },
  "build": {
    "appId": "app.pagefolio.desktop",
    "productName": "Pagefolio",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraFiles": [
      "README.md",
      "LICENSE",
      "WINDOWS-使い方.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "artifactName": "Pagefolio-${version}-Windows-${arch}.${ext}"
  }
}
